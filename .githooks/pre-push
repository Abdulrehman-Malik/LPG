#!/bin/sh
# Blocks direct pushes to main. Work on a feature branch and open a pull request.
protected="refs/heads/main"
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected" ]; then
    echo "ERROR: direct push to main is blocked."
    echo "Create a feature branch (git switch -c feature/<name>), push it, then open a PR."
    exit 1
  fi
done
exit 0
